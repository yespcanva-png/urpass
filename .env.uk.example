# ==============================================================================
# UrPass UK — Sovereign Production Environment Configuration
# Target: app.uk.urpass.space (Application) & uk.urpass.space (Marketing)
# Data Residency: AWS eu-west-2 (London)
# ==============================================================================

# UK Database & Supabase (Dedicated EU/UK Project)
NEXT_PUBLIC_SUPABASE_URL=https://your-uk-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_uk_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_uk_service_role_key_here

# UK Domain & URLs
NEXT_PUBLIC_APP_URL=https://app.uk.urpass.space
NEXT_PUBLIC_MARKETING_URL=https://uk.urpass.space
NEXT_PUBLIC_SITE_URL=https://uk.urpass.space

# UK Regional Defaults
NEXT_PUBLIC_DEFAULT_COUNTRY=GB
NEXT_PUBLIC_DEFAULT_CURRENCY=GBP
NEXT_PUBLIC_DEFAULT_TIMEZONE=Europe/London
NEXT_PUBLIC_DEFAULT_LOCALE=en-GB

# UK Financial & Payment Safety (Strictly Fail-Closed until provider approval)
# DO NOT enable without authorized UK merchant approval and legal sign-off
NEXT_PUBLIC_UK_PAID_TICKETING=false
NEXT_PUBLIC_UK_ORGANIZER_MOR=false
UK_PAYMENT_GATEWAY_PROVIDER=pending # e.g. stripe_uk once approved
STRIPE_UK_SECRET_KEY=
STRIPE_UK_PUBLISHABLE_KEY=
STRIPE_UK_WEBHOOK_SECRET=

# UK Invoicing & Tax Defaults
UK_PLATFORM_VAT_NUMBER=
UK_PLATFORM_COMPANY_NUMBER=
UK_VAT_RATE_PERCENT=20

# Google OAuth (UK Dedicated Cloud Console Project)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-uk-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-uk-google-client-secret

# UK Transactional Email (Resend EU / UK SMTP)
RESEND_API_KEY=re_your_resend_uk_api_key
EMAIL_FROM="UrPass UK <tickets@uk.urpass.space>"
SUPPORT_EMAIL=support@uk.urpass.space
DPO_EMAIL=privacy@uk.urpass.space

# Apple Wallet Integration (.pkpass UK Passes)
APPLE_PASS_TYPE_ID=pass.space.urpass.uk.ticket
APPLE_PASS_TEAM_ID=your_apple_developer_team_id
APPLE_PASS_CERT_BASE64=
APPLE_PASS_KEY_BASE64=
APPLE_PASS_WWDR_BASE64=

# Security & Server Actions Encryption Key
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=uk_generated_32_byte_base64_encryption_key_here
